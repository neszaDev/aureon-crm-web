# Copied to env/.env (git-ignored) by `make setup`. Read by `pnpm dev` (via dotenv) and Compose.

# Where the Next.js server reaches the Spring API (server-side only, never sent to browsers).
BACKEND_URL=http://localhost:8080
# Public URL of this frontend; https:// makes auth cookies Secure. Used for sitemap/robots.
APP_URL=http://localhost:3000

# Logging level for the app logger: error | warning | info | debug | trace | fatal
NEXT_PUBLIC_LOGGING_LEVEL=debug
NEXT_TELEMETRY_DISABLED=1
# Optional browser key for the Google Maps demo page (/dashboard/google-maps). Inlined at build time.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Local Docker stack (make backend-up / make up) ---
# Backend image tag from ghcr.io/neszadev/spring-postgres-boilerplate (dev = latest dev build).
BACKEND_TAG=dev
BACKEND_PORT=8080
FRONTEND_PORT=3000
# Local-only JWT secret for the backend container (>= 32 bytes). Never a real secret.
BACKEND_JWT_SECRET=local-development-secret-at-least-32-bytes
# Admin the local backend creates at startup (e2e signs in with it). Local only.
BACKEND_ADMIN_EMAIL=admin@e2e.test
BACKEND_ADMIN_PASSWORD=e2e-admin-password
# Per-IP sign-in/registration limit of the local backend (e2e registers every user from one IP).
BACKEND_RATE_LIMIT_PER_IP=10000

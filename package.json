{
  "name": "nextjs-boilerplate",
  "author": "neszaDev (based on Next.js Boilerplate by Ixartz, https://github.com/ixartz)",
  "type": "module",
  "scripts": {
    "dev": "dotenv -e env/.env -- next dev",
    "dev:next": "next dev",
    "build": "dotenv -e env/.env -- next build",
    "typegen": "dotenv -e env/.env -- next typegen",
    "analyze": "next experimental-analyze",
    "clean": "rimraf .next out coverage",
    "lint": "ultracite check --type-aware --type-check",
    "lint:fix": "ultracite fix --type-aware --type-check",
    "check:types": "tsc --noEmit --pretty",
    "check:deps": "knip",
    "check:i18n": "i18n-check -l src/locales -s en -u src -f next-intl",
    "api:types": "pnpm dlx --package=openapi-typescript@7.13.0 --package=typescript@5.9.3 openapi-typescript \"${BACKEND_URL:-http://localhost:8080}/v3/api-docs\" -o src/libs/api/schema.d.ts",
    "commit": "commit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006",
    "storybook:test": "vitest run --config .storybook/vitest.config.ts",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@logtape/logtape": "2.3.1",
    "@t3-oss/env-nextjs": "0.13.11",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "lucide-react": "1.49.0",
    "next": "16.3.1",
    "next-intl": "4.13.4",
    "openapi-fetch": "^0.17.0",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.85.0",
    "server-only": "^0.0.1",
    "translation-resilience": "0.3.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@commitlint/prompt-cli": "21.2.2",
    "@commitlint/types": "21.2.0",
    "@lingual/i18n-check": "0.9.5",
    "@playwright/test": "1.62.1",
    "@storybook/addon-a11y": "10.5.8",
    "@storybook/addon-docs": "10.5.8",
    "@storybook/addon-vitest": "10.5.8",
    "@storybook/nextjs-vite": "10.5.8",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "25.9.5",
    "@types/react": "19.2.18",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/browser": "4.1.10",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "dotenv-cli": "11.0.0",
    "knip": "6.32.2",
    "lefthook": "2.1.10",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "rimraf": "6.1.3",
    "shadcn": "4.21.0",
    "storybook": "10.5.8",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "ultracite": "7.10.5",
    "vite": "^8.2.1",
    "vitest": "4.1.10",
    "vitest-browser-react": "2.2.0"
  },
  "overrides": {
    "hono": "4.12.31"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.9.0",
  "postcss": {
    "plugins": {
      "@tailwindcss/postcss": {}
    }
  }
}

{
  "name": "nextjs-boilerplate",
  "author": "neszaDev (based on Next.js Boilerplate by Ixartz, https://github.com/ixartz)",
  "type": "module",
  "scripts": {
    "dev": "dotenv -e env/.env -- next dev",
    "dev:next": "next dev",
    "build": "dotenv -e env/.env -- next build",
    "typegen": "dotenv -e env/.env -- next typegen",
    "analyze": "next experimental-analyze",
    "clean": "rimraf .next out coverage",
    "lint": "ultracite check --type-aware --type-check",
    "lint:fix": "ultracite fix --type-aware --type-check",
    "check:types": "tsc --noEmit --pretty",
    "check:deps": "knip",
    "check:i18n": "i18n-check -l src/locales -s en -u src -f next-intl",
    "api:types": "node scripts/api-types.ts",
    "commit": "commit",
    "test": "vitest run",
    "test:e2e": "playwright test --project=chromium",
    "storybook": "storybook dev -p 6006",
    "storybook:test": "vitest run --config .storybook/vitest.config.ts",
    "build-storybook": "storybook build",
    "api:check": "node scripts/api-types.ts --check",
    "test:visual": "playwright test --project=visual"
  },
  "dependencies": {
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-markdown": "6.5.2",
    "@coreui/icons": "3.1.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@hookform/resolvers": "5.9.1",
    "@logtape/logtape": "2.3.1",
    "@t3-oss/env-nextjs": "0.13.11",
    "@tanstack/react-table": "9.2.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@uiw/react-codemirror": "4.25.12",
    "@vis.gl/react-google-maps": "1.10.1",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.4.0",
    "date-fns": "4.4.0",
    "embla-carousel-react": "8.6.0",
    "input-otp": "1.5.0",
    "lucide-react": "1.49.0",
    "next": "16.3.8",
    "next-intl": "4.13.4",
    "openapi-fetch": "^0.17.0",
    "qrcode.react": "4.2.0",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-day-picker": "10.0.2",
    "react-dom": "19.2.8",
    "react-hook-form": "7.85.0",
    "react-imask": "7.6.1",
    "recharts": "3.8.0",
    "server-only": "^0.0.1",
    "sonner": "2.0.8",
    "translation-resilience": "0.3.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@commitlint/prompt-cli": "21.2.2",
    "@commitlint/types": "21.2.0",
    "@lingual/i18n-check": "0.9.5",
    "@playwright/test": "1.62.1",
    "@storybook/addon-a11y": "10.5.8",
    "@storybook/addon-docs": "10.5.8",
    "@storybook/addon-vitest": "10.5.8",
    "@storybook/nextjs-vite": "10.5.8",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "25.9.5",
    "@types/react": "19.2.18",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/browser": "4.1.10",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "dotenv-cli": "11.0.0",
    "knip": "6.32.2",
    "lefthook": "2.1.10",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "rimraf": "6.1.3",
    "shadcn": "4.21.0",
    "storybook": "10.5.8",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "ultracite": "7.10.5",
    "vite": "^8.2.1",
    "vitest": "4.1.10",
    "vitest-browser-react": "2.2.0"
  },
  "overrides": {
    "hono": "4.12.31"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.9.0",
  "postcss": {
    "plugins": {
      "@tailwindcss/postcss": {}
    }
  }
}
